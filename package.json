{
  "name": "plinth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 component library foundation template",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "node scripts/prepare-lefthook.mjs",
    "dev": "turbo run dev --filter=@plinth/playground",
    "dev:docs": "pnpm --filter @plinth/docs dev",
    "build": "turbo run build --filter=@plinth/ui",
    "build:site": "pnpm --filter @plinth/docs build && pnpm --filter @plinth/playground build",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:node",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "lint:fix": "eslint . --cache --cache-location .cache/eslint/ --fix",
    "format": "eslint . --cache --cache-location .cache/eslint/ --fix && prettier . --write --cache --log-level warn",
    "check:cspell": "cspell lint \"**/*.{ts,vue,md,mjs}\" --no-progress",
    "check:contract": "tsx internal/build/src/contract/check.ts",
    "contract:sync": "tsx internal/build/src/contract/sync.ts",
    "check:docs": "pnpm --filter @plinth/docs check:coverage",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:contract && pnpm check:docs && pnpm build",
    "gen": "node scripts/gen/index.mjs",
    "bootstrap": "node scripts/bootstrap/index.mjs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "clean": "node scripts/clean.mjs",
    "clean:hard": "node scripts/clean.mjs --hard"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "^2.31.1",
    "@clack/prompts": "^0.11.0",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-config-turbo": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "happy-dom": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-vue": "catalog:",
    "validate-npm-package-name": "^6.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.1"
}
