{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/lib.config.ts",
        "$TURBO_ROOT$/typings/global.d.ts"
      ],
      "outputs": ["dist/**", "es/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
